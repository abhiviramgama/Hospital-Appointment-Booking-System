# Django Hospital SaaS Environment Variables
SECRET_KEY=django-insecure-hospital-saas-dev-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Asia/Kolkata

# Database: sqlite or postgresql
DB_ENGINE=sqlite
DB_NAME=hospital_db
